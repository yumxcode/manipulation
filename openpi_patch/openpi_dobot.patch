+@dataclasses.dataclass(frozen=True)
+class LeRobotDobotDataConfig(DataConfigFactory):
+    """越疆 CR5AF 单臂插头插拔（数据由 dobot_plug/scripts/convert_to_lerobot.py 生成）。
+
+    数据集字段: base_0_rgb / left_wrist_0_rgb / [right_wrist_0_rgb], state, actions, [advantage]
+    actions = 绝对目标关节角(6, rad) + 夹爪(1)；这里转成相对当前关节角的增量（夹爪保持绝对）。
+    """
+
+    # 数据集中实际存在的图像槽位（只有两台相机时去掉 right_wrist_0_rgb）
+    image_slots: tuple[str, ...] = dobot_policy.IMAGE_SLOTS
+    # RECAP：数据集带 advantage 字段，并把优势指示写进 prompt
+    recap: bool = False
+    recap_dropout: float = 0.3
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        mapping = {f"observation/{slot}": slot for slot in self.image_slots}
+        mapping.update({"observation/state": "state", "actions": "actions", "prompt": "prompt"})
+        if self.recap:
+            mapping["advantage"] = "advantage"
+        repack_transform = _transforms.Group(inputs=[_transforms.RepackTransform(mapping)])
+
+        inputs = [dobot_policy.DobotInputs(model_type=model_config.model_type)]
+        if self.recap:
+            inputs.append(dobot_policy.AdvantagePrompt(dropout=self.recap_dropout))
+        data_transforms = _transforms.Group(inputs=inputs, outputs=[dobot_policy.DobotOutputs()])
+
+        delta_action_mask = _transforms.make_bool_mask(6, -1)
+        data_transforms = data_transforms.push(
+            inputs=[_transforms.DeltaActions(delta_action_mask)],
+            outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+        )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
+
