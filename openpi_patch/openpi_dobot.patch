+"""越疆 CR5AF 单臂 + 平行夹爪（插头插拔）的 openpi 输入/输出变换。
+
+客户端（dobot_plug/scripts/run_policy.py）发送的 observation 键：
+    observation/base_0_rgb, observation/left_wrist_0_rgb, [observation/right_wrist_0_rgb]
+    observation/state   (7 或 13 维: q(6,rad) + gripper(1) [+ F/T(6)])
+    prompt
+训练时由 LeRobot 数据集经 RepackTransform 映射到相同的键。
+
+RECAP（π*0.6 风格的优势条件化）:
+    训练数据多一个 "advantage" 字段 (1.0=positive / 0.0=negative)，
+    AdvantagePrompt 会把 "\\nAdvantage: positive|negative" 追加到 prompt 末尾，并以一定概率丢弃
+    （使模型同时学会无条件策略，可做 CFG）。
+    推理时客户端直接在 prompt 末尾带上 "\\nAdvantage: positive"，不发送 advantage 字段，此变换为 no-op。
+"""
+
+import dataclasses
+import random
+
+import einops
+import numpy as np
+
+from openpi import transforms
+from openpi.models import model as _model
+
+IMAGE_SLOTS = ("base_0_rgb", "left_wrist_0_rgb", "right_wrist_0_rgb")
+ACTION_DIM = 7
+RECAP_POS = "\nAdvantage: positive"
+RECAP_NEG = "\nAdvantage: negative"
+
+
+def make_dobot_example(state_dim: int = 13) -> dict:
+    return {
+        "observation/base_0_rgb": np.random.randint(256, size=(240, 320, 3), dtype=np.uint8),
+        "observation/left_wrist_0_rgb": np.random.randint(256, size=(240, 320, 3), dtype=np.uint8),
+        "observation/right_wrist_0_rgb": np.random.randint(256, size=(240, 320, 3), dtype=np.uint8),
+        "observation/state": np.random.rand(state_dim).astype(np.float32),
+        "prompt": "insert the plug into the socket",
+    }
+
+
+def _parse_image(image) -> np.ndarray:
+    image = np.asarray(image)
+    if np.issubdtype(image.dtype, np.floating):
+        image = (255 * image).astype(np.uint8)
+    if image.shape[0] == 3:
+        image = einops.rearrange(image, "c h w -> h w c")
+    return image
+
+
+@dataclasses.dataclass(frozen=True)
+class DobotInputs(transforms.DataTransformFn):
+    model_type: _model.ModelType
+
+    def __call__(self, data: dict) -> dict:
+        images, masks = {}, {}
+        ref = None
+        for slot in IMAGE_SLOTS:
+            key = f"observation/{slot}"
+            if key in data:
+                images[slot] = _parse_image(data[key])
+                masks[slot] = np.True_
+                ref = images[slot] if ref is None else ref
+        if ref is None:
+            raise ValueError("observation 中没有任何图像")
+        for slot in IMAGE_SLOTS:
+            if slot not in images:
+                images[slot] = np.zeros_like(ref)
+                # pi0/pi05 对补零的图像槽位做 mask；pi0-FAST 不 mask
+                masks[slot] = np.True_ if self.model_type == _model.ModelType.PI0_FAST else np.False_
+
+        inputs = {"state": np.asarray(data["observation/state"], dtype=np.float32), "image": images, "image_mask": masks}
+        if "actions" in data:
+            inputs["actions"] = data["actions"]
+        if "prompt" in data:
+            inputs["prompt"] = data["prompt"]
+        if "advantage" in data:
+            inputs["advantage"] = data["advantage"]
+        return inputs
+
+
+@dataclasses.dataclass(frozen=True)
+class AdvantagePrompt(transforms.DataTransformFn):
+    """RECAP：把二值优势指示写进语言指令。只在数据里存在 "advantage" 字段（即训练）时生效。"""
+
+    dropout: float = 0.3
+
+    def __call__(self, data: dict) -> dict:
+        if "advantage" not in data:
+            return data
+        data = dict(data)
+        adv = float(np.asarray(data.pop("advantage")).reshape(-1)[0])
+        prompt = data.get("prompt", "")
+        if isinstance(prompt, bytes):
+            prompt = prompt.decode()
+        prompt = str(prompt)
+        if random.random() >= self.dropout:
+            prompt = prompt + (RECAP_POS if adv >= 0.5 else RECAP_NEG)
+        data["prompt"] = prompt
+        return data
+
+
+@dataclasses.dataclass(frozen=True)
+class DobotOutputs(transforms.DataTransformFn):
+    def __call__(self, data: dict) -> dict:
+        return {"actions": np.asarray(data["actions"][..., :ACTION_DIM])}
